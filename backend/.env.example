# --- Serveur ---
PORT=4000
NODE_ENV=development

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/qr-patrol?retryWrites=true&w=majority

# --- Sécurité ---
# Chaînes longues et aléatoires (ex : openssl rand -hex 48)
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d
# Signe les QR Codes des points de contrôle. NE JAMAIS la changer en production
# sans régénérer et réimprimer tous les QR.
QR_SECRET=change-me-qr-secret
# Signe les liens temporaires vers les photos/vidéos
MEDIA_SECRET=change-me-media-secret

# --- CORS : origines autorisées, séparées par des virgules ---
CORS_ORIGINS=http://localhost:3000,https://qr-patrol-web.vercel.app

# URL publique de l'API (utilisée pour les liens médias)
PUBLIC_API_URL=http://localhost:4000

# --- Planificateur des rondes (désactiver sur une 2e instance) ---
SCHEDULER_ENABLED=true
TZ=Africa/Kinshasa

# --- Compte super administrateur créé par `npm run seed` ---
SEED_SUPERADMIN_EMAIL=admin@rooksecurity.cd
SEED_SUPERADMIN_PASSWORD=ChangeMoi!2026
SEED_ORG_NAME=FAMECO
SEED_DEMO_DATA=true
